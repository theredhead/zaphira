{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "Zaphira.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Zaphira.sln",
        "--no-restore",
        "--disable-build-servers",
        "--verbosity",
        "minimal",
        "-maxcpucount:1",
        "-p:UseSharedCompilation=false",
        "-p:BuildInParallel=false"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "restore"
      ]
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "Zaphira.sln",
        "--no-restore",
        "--disable-build-servers",
        "--verbosity",
        "minimal",
        "-maxcpucount:1",
        "-p:UseSharedCompilation=false",
        "-p:BuildInParallel=false"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": [
        "restore"
      ]
    }
  ]
}
