<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Zaphira.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Zaphira.Client.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Zaphira"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter"
                    Command="{Binding ChatWorkspace.SendMessageCommand}"/>
        <KeyBinding Gesture="Meta+Enter"
                    Command="{Binding ChatWorkspace.SendMessageCommand}"/>
        <KeyBinding Gesture="Ctrl+N"
                    Command="{Binding ChatWorkspace.StartNewConversationCommand}"/>
        <KeyBinding Gesture="Meta+N"
                    Command="{Binding ChatWorkspace.StartNewConversationCommand}"/>
        <KeyBinding Gesture="Escape"
                    Command="{Binding ChatWorkspace.StopGenerationCommand}"/>
    </Window.KeyBindings>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="260,*">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding ApplicationTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BackendConnectionStateText}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BackendAddressText}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AvailabilitySuggestionText}"
                               IsVisible="{Binding HasBlockingAvailabilityState}"
                               VerticalAlignment="Center"/>
                    <Button Content="Retry"
                            Command="{Binding RefreshBackendConnectionCommand}"
                            IsVisible="{Binding HasBlockingAvailabilityState}"
                            TabIndex="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <StackPanel Spacing="8">
                    <Button Content="Setup"
                            Command="{Binding ShowFirstRunCommand}"
                            HorizontalAlignment="Stretch"
                            TabIndex="0"/>
                    <Button Content="Chat"
                            Command="{Binding ShowChatCommand}"
                            HorizontalAlignment="Stretch"
                            TabIndex="1"/>
                    <Button Content="Settings"
                            Command="{Binding ShowSettingsCommand}"
                            HorizontalAlignment="Stretch"
                            TabIndex="2"/>
                </StackPanel>

                <Button Grid.Row="1"
                        Content="New Chat"
                        Command="{Binding ChatWorkspace.StartNewConversationCommand}"
                        HorizontalAlignment="Stretch"
                        TabIndex="3"/>

                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding ChatWorkspace.Conversations}"
                                  AutomationProperties.Name="Conversations">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ConversationItemViewModel">
                                <Button Command="{Binding DataContext.ChatWorkspace.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        x:CompileBindings="False"
                                        HorizontalAlignment="Stretch"
                                        Padding="10"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
            <Grid ColumnDefinitions="*,220" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SelectedPageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ChatWorkspace.StatusText}"/>
                </StackPanel>
                <TextBox Grid.Column="1"
                         Text="{Binding ChatWorkspace.ActiveModelId}"
                         PlaceholderText="Model"
                         VerticalAlignment="Top"
                         TabIndex="10"
                         AutomationProperties.Name="Model"/>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding ChatWorkspace.SelectedConversationTitle}"
                             PlaceholderText="Conversation title"
                             TabIndex="11"
                             AutomationProperties.Name="Conversation title"/>
                    <Button Grid.Column="1"
                            Content="Rename"
                            Command="{Binding ChatWorkspace.RenameConversationCommand}"
                            TabIndex="12"/>
                    <Button Grid.Column="2"
                            Content="Delete"
                            Command="{Binding ChatWorkspace.RequestDeleteConversationCommand}"
                            TabIndex="13"/>
                    <Button Grid.Column="3"
                            Content="Confirm Delete"
                            Command="{Binding ChatWorkspace.ConfirmDeleteConversationCommand}"
                            IsVisible="{Binding ChatWorkspace.IsConfirmingDelete}"
                            TabIndex="14"/>
                    <Button Grid.Column="4"
                            Content="Cancel"
                            Command="{Binding ChatWorkspace.CancelDeleteConversationCommand}"
                            IsVisible="{Binding ChatWorkspace.IsConfirmingDelete}"
                            TabIndex="15"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" BorderThickness="1" Padding="0">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ChatWorkspace.Messages}" Margin="16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ChatMessageViewModel">
                                <Border BorderThickness="1"
                                        Padding="12"
                                        Margin="0,0,0,12"
                                        CornerRadius="6">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Role}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Status}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding RenderedParts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:RenderedMessagePartViewModel">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding Text}"
                                                                   IsVisible="{Binding IsParagraph}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Text}"
                                                                   IsVisible="{Binding IsHeadingOne}"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Text}"
                                                                   IsVisible="{Binding IsHeadingTwo}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Text}"
                                                                   IsVisible="{Binding IsHeadingThree}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <Grid ColumnDefinitions="Auto,*"
                                                              ColumnSpacing="8"
                                                              IsVisible="{Binding IsListItem}">
                                                            <TextBlock Text="-"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Text}"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                        <Border IsVisible="{Binding IsQuote}"
                                                                BorderThickness="2,0,0,0"
                                                                Padding="10,0,0,0">
                                                            <TextBlock Text="{Binding Text}"
                                                                       FontStyle="Italic"
                                                                       TextWrapping="Wrap"/>
                                                        </Border>
                                                        <Border IsVisible="{Binding IsCodeBlock}"
                                                                Padding="10"
                                                                CornerRadius="4">
                                                            <StackPanel Spacing="8">
                                                                <TextBlock Text="{Binding CodeHeader}"
                                                                           FontSize="12"/>
                                                                <ItemsControl ItemsSource="{Binding CodeLines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="vm:RenderedCodeLineViewModel">
                                                                            <ItemsControl ItemsSource="{Binding Tokens}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate DataType="vm:RenderedCodeTokenViewModel">
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       IsVisible="{Binding IsPlain}"
                                                                                                       FontFamily="Consolas, Menlo, Monaco, monospace"/>
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       IsVisible="{Binding IsKeyword}"
                                                                                                       FontFamily="Consolas, Menlo, Monaco, monospace"
                                                                                                       FontWeight="SemiBold"/>
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       IsVisible="{Binding IsStringLiteral}"
                                                                                                       FontFamily="Consolas, Menlo, Monaco, monospace"
                                                                                                       FontStyle="Italic"/>
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                                       IsVisible="{Binding IsComment}"
                                                                                                       FontFamily="Consolas, Menlo, Monaco, monospace"
                                                                                                       FontStyle="Italic"/>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ChatWorkspace.ComposerText}"
                         PlaceholderText="Message"
                         AcceptsReturn="True"
                         MinHeight="76"
                         TextWrapping="Wrap"
                         TabIndex="20"
                         AutomationProperties.Name="Message"/>
                <Button Grid.Column="1"
                        Content="Stop"
                        Command="{Binding ChatWorkspace.StopGenerationCommand}"
                        VerticalAlignment="Stretch"
                        TabIndex="21"/>
                <Button Grid.Column="2"
                        Content="Send"
                        Command="{Binding ChatWorkspace.SendMessageCommand}"
                        VerticalAlignment="Stretch"
                        TabIndex="22"/>
            </Grid>
        </Grid>
    </Grid>

</Window>
