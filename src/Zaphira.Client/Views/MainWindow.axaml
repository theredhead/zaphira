<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Zaphira.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Zaphira.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Zaphira">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*" Background="#F7F7F4">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#202124" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding ApplicationTitle}"
                           Foreground="#FFFFFF"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BackendConnectionStateText}"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BackendAddressText}"
                               Foreground="#C9D1D9"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#ECEDE8" Padding="12">
            <StackPanel Spacing="8">
                <Button Content="Setup" Command="{Binding ShowFirstRunCommand}" HorizontalAlignment="Stretch"/>
                <Button Content="Chat" Command="{Binding ShowChatCommand}" HorizontalAlignment="Stretch"/>
                <Button Content="Settings" Command="{Binding ShowSettingsCommand}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" Margin="24">
            <TextBlock Text="{Binding SelectedPageTitle}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#202124"/>
            <Border Grid.Row="1" Margin="0,18,0,0" BorderBrush="#D0D5D2" BorderThickness="1" Padding="18">
                <TextBlock Text="{Binding SelectedPageTitle}" Foreground="#202124"/>
            </Border>
        </Grid>
    </Grid>

</Window>
